# LOTTERY QUANT ULTRA — exemplo de variáveis de ambiente.
# NENHUM valor real aqui. O núcleo matemático e seus testes NÃO exigem segredos (§26).
# As chaves abaixo pertencem a módulos ainda NÃO INICIADOS (apps/web, data, providers).

# Ambiente lógico da aplicação (dev | preview | production). Valida coerência com recursos (§23).
APP_ENV=dev

# PostgreSQL (Neon) — pooling obrigatório; nunca credencial de produção em preview (§23).
# DATABASE_URL=

# Clerk (sessões/identidade) — acesso privado por convite na publicação inicial (§5).
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Vercel Blob (objetos privados).
# BLOB_READ_WRITE_TOKEN=

# Provider oficial CAIXA (§12) — endpoints a confirmar na implementação; sem contrato estável.
# CAIXA_LOTOFACIL_URL=https://servicebus2.caixa.gov.br/portaldeloterias/api/lotofacil
# CAIXA_MEGASENA_URL=https://servicebus2.caixa.gov.br/portaldeloterias/api/megasena

# Solver externo opcional (adaptador) — não bloqueia a Entrega A (§5, §9.3).
# SOLVER_ENDPOINT=
