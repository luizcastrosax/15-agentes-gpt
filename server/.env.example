# ═══ ParkFlow · configuração de produção ═══
# Copie para ".env" e ajuste. Tudo que não for definido cai no modo simulado.

PORT=4000

# ── Cancela (relé) ──
# GATE_DRIVER=mock          # mock | gpio | http
# GATE_GPIO_ENTRADA=17      # pino BCM (Raspberry Pi) do relé de entrada
# GATE_GPIO_SAIDA=27        # pino BCM do relé de saída
# GATE_HTTP_ENTRADA=http://192.168.0.50/relay/0?turn=on   # relé de rede (Shelly/USR)
# GATE_HTTP_SAIDA=http://192.168.0.51/relay/0?turn=on
# GATE_PULSE_MS=600

# ── Impressora térmica (ESC/POS) ──
# PRINTER_DRIVER=mock        # mock | escpos
# PRINTER_TYPE=epson         # epson | star
# PRINTER_INTERFACE=tcp://192.168.0.100   # rede; ou "printer:auto" (USB); ou /dev/usb/lp0

# ── Sua chave PIX (recebedor) ──
# Pode ser CPF, e-mail, telefone ou chave aleatória. Este arquivo (.env) NÃO
# vai para o GitHub — mantenha seu CPF só aqui, na máquina do estacionamento.
# PIX_KEY=seu-cpf-email-telefone-ou-chave-aleatoria
# PIX_NAME=SEU NOME OU RAZAO SOCIAL
# PIX_CITY=SUA CIDADE

# ── PIX automático (confirmação pelo banco) ──
# Só a chave acima gera o QR, mas NÃO confirma o pagamento sozinho.
# Para a cancela abrir automaticamente, é preciso a API do banco/PSP:
# PIX_PROVIDER=mock          # mock | mercadopago
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx   # token de PRODUÇÃO do Mercado Pago
# PIX_WEBHOOK_URL=https://seu-dominio.com/api/webhook/pix   # onde o MP avisa o pagamento
