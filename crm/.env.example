# Senha do primeiro administrador (admin@crm.local). Defina antes do primeiro acesso.
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar o cookie de sessao. Use uma string longa e aleatoria.
AUTH_SECRET=

# Banco Postgres (Neon / Vercel Postgres). Sem isso o CRM roda em modo demonstracao,
# guardando os dados apenas em memoria. A Vercel injeta esta variavel automaticamente
# quando voce conecta um banco em Storage.
DATABASE_URL=
